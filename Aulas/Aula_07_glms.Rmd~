    nsobrev ~ dbinom(100 , p),
    logit(p) <- b0 + b1*distc,
    b0 ~ dnorm(-1, 2),
    b1 ~ dnorm(0, 0.2)
    )
    
mbin1 <- ulam(mbin1.f,
               data = pred.seed,
               chains = 4,
