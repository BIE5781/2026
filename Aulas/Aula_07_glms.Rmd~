b1 <- rnorm(n1,0,10)
plot(0,0, xlim=c(-15,45), ylim=c(0,1), type = "n",
     xlab="Distância centrada da árvore-mãe", ylab="Proporção sobrevivente")
for(i in 1:length(b0)) curve(logistica(x, b0[i],b1[i]), add=TRUE, col="grey") 
