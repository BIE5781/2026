%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\subsection{Não-lineares}

\begin{frame}{E o que são preditores não lineares?}

  Todos que não podem ser reduzidos à forma $\Theta \ = \ \sum \alpha_iX_i$.

  \begin{block}{exemplos}
    \begin{itemize}
      
    \item $\alpha_0X_1^{\alpha_1}$
      
    \item $\alpha_0e^{\alpha_1 X_1}$
      
    \item $\frac{\alpha_1 X_1}{1+\alpha_1\alpha_2X_1}$
      
    \item E  muitas, muitas mais.
    \end{itemize}
  \end{block}

\end{frame}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\section{Modelos binomiais}
\label{sec:regressao-binomial}

\subsection{Introdução}

\begin{frame}[<+->]{Modelos Binomiais}
  \begin{itemize}
  \item Descrevem número de ocorrência de uma variável binária em um certo número de tentativas,  
    em função de variáveis preditoras contínuas ou discretas.
  \item Úteis principalmente quando temos:
    \begin{itemize}
    \item Respostas binárias (regressão logística!)
    \item Proporções
    \end{itemize} 
    
  \item Exemplos de respostas binomiais:
    \begin{itemize}
    \item Presença de alguma espécie em manchas, fragmentos, sítios;
    \item Ocorrência de morte, doença ou qualquer outro evento por indivíduo
    \item Proporção de frutos parasitados
    \item Experimentos de dose-resposta  
    \end{itemize}
  \end{itemize}
\end{frame}

