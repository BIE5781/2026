\section{Introdução}

\subsection{Objetivos}
\begin{frame}{Objetivo da Aula}
  Os objetivos dessa aula são:
  \begin{enumerate}
  \item<2-> Generalizar o conceito de modelos lineares  
  \item<3-> Aplicar esta generalização para definir modelos com distribuições não Gaussianas;
  \item<4-> Exemplificar essas generalização com modelos Poisson e binomial;
  \item<5-> Mostrar os comandos básicos no \R \ para ajustar e avaliar esses modelos;
  \item<6-> Mostrar que alguns deles pertencem à classe dos modelos lineares generalizados (glms);
  \item<7-> Apresentar ajuste de glms no \R.
  \end{enumerate}
\end{frame}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% 
\subsection{Motivação}

\begin{frame}[<+->]{Onde estamos}
  Até agora vimos: \\
  \begin{itemize}
  \item<2-> Modelos de várias distribuições com parâmetros constantes:
    \begin{eqnarray*}
      Y & \sim & N(\mu=a_0, \, \sigma=b_0)  \\
      Y & \sim & \textrm{Pois}(\lambda=a_0)  \\ 
       \cdots  &  & 
    \end{eqnarray*}
  \item<3-> Modelos Gaussianos lineares:
    \begin{eqnarray*}
      Y &\sim & N(\mu=a_0+a_1X_1, \, \sigma=b_0)  \\ 
      Y & \sim & N \left( \mu=a_0+a_1X_1+a_2X_2, \, \sigma=e^{b_0+b_1X_1} \right)  \\ 
      \cdots &  & \
    \end{eqnarray*}
  \end{itemize}
\end{frame}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% 

\begin{frame}[<+->]{Para onde vamos}
  Hoje veremos modelos de distribuições não Gaussianas preditoras, como:
  \begin{itemize}
  \item Modelos Binomiais:
    \begin{displaymath}
      Y \, \sim \, \textrm{Bin}(N=n, \, p= g(X_i))
    \end{displaymath}
  \item Modelos Poisson:
    \begin{displaymath}
      Y \, \sim \, \textrm{Pois}(\lambda= g(X_i))
    \end{displaymath}
  \end{itemize}
\end{frame}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\begin{frame}[<+->]{Ou seja}
  \begin{block}{Uma expressão geral para modelos estatísticos}
    \begin{displaymath}
      Y\, \sim \, f(Y \mid \Theta=g(X_i))
    \end{displaymath}
  \end{block}
  \begin{block}{Em palavras}
    $Y$ é uma variável aleatória, cujos valores tem probabilidades
    definidas pela função de densidade $f(Y)$, cujos parâmetros
    $\Theta$ são uma função qualquer $g$ de outras medidas
    (preditoras) $X_i$.
  \end{block}
\end{frame}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\section{O preditor linear}

\subsection{Definição}

\begin{frame}{Preditores lineares}
  
  \begin{block}{Todos que podem ser escritos na forma}
    $$\Theta \ = \ g(X_i) \ = \sum
    \alpha_iX_i$$  
  \end{block}

    sendo $\Theta$ uma resposta (que normalmente usamos para expressar a
    dependência de um parâmetro da distribuição com outras medidas).

\end{frame}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\begin{frame}{Preditores lineares}
\begin{block}{exemplos}
  \begin{itemize}
    \setlength\itemsep{1em}
  \item<1-5> $\alpha_0+\alpha_1X_1$ , sendo $X_0=1$
  \item<2-5> $\alpha_0+\alpha_1X_1+\alpha_2X_1^2$ , pois podemos chamar $X_1^2$ de  $X_2$
  \item<3-5> $\alpha_0+\alpha_1X_1+\alpha_2\ln(X_1)$ , pois podemos chamar $\ln X_1$ de  $X_2$
  \item<4-6> $\alpha_0+\alpha_1X_1+\alpha_2X_2+\alpha_3X_1X_2$ , pois podemos chamar $X_1X_2$ de  $X_3$  
  \item<5-5> \dots  
  \end{itemize}
\end{block}
\end{frame}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% 

\subsection{Aditividade}

\begin{frame}[<+->]{Modelos lineares múltiplos aditivos}
  \begin{itemize}
  \item O preditor é a soma de variáveis independentes isoladas, cada uma multiplicada por seu coeficiente
  \item A soma \textbf{não} inclui variáveis independentes que são produtos de outras presentes no modelo:
    \begin{equation*}
  \alpha_0+\alpha_1X_1+\alpha_2X_2 + \cdots + \alpha_iX_i
    \end{equation*}
  \item Se a uma variável independente $X_i$ dobra, seu efeito no preditor vai aumentar em $2 \times \alpha_i$, não importando o valor das outras variáveis.  
  \item Ou seja, os  efeitos das preditoras são \textbf{aditivos}. Não são afetados pelo valor das demais variáveis. 
  \end{itemize}
\end{frame}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\begin{frame}[<+->]{Modelos lineares múltiplos com interações}
  \begin{itemize}
  \item O preditor inclui variáveis que são produtos de pelo menos outras duas presentes no modelo, por exemplo
    \begin{displaymath}
      \alpha_0+\alpha_1X_1+\alpha_2X_2 + \alpha_3X_1X_2
    \end{displaymath}
  \item Se a variável independente $X_1$ dobra, seu efeito no preditor vai aumentar em
    \begin{displaymath}
    2 \times \alpha_1 + 2 \times \alpha_3X_2.
  \end{displaymath}
  \item Ou seja, o  efeito de uma preditora depende do valor de outra(s). Há uma \textbf{interação} estatística.
  \end{itemize}
\end{frame}


