\begin{frame}[<+->]{Modelos Poisson}
  \begin{itemize}
  \item Nosso modelo é:
    \begin{displaymath}
      Y \, \sim \, \textrm{Pois} ( \lambda = g(\textrm{área}) )
    \end{displaymath}
  \item Que função usar para o efeito do log da área sobre $\lambda$?
  \item Uma função monotônica positiva como a exponencial: 
    \begin{displaymath}
      \lambda\, = \, e^{a_0+a_1 \textrm{área}}
    \end{displaymath}
  \item O que implica em
    \begin{displaymath}
    \ln(\lambda) \, = \, a_0+a_1\textrm{área}
  \end{displaymath}
  \end{itemize}
\end{frame}
