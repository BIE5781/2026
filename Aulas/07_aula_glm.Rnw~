%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% 

\begin{frame}[<+->]{A família exponencial de distribuições \footnote{Não é o mesmo que distribuição exponencial}}
  \begin{itemize}
  \item Distribuições que podem ser expressas por  
    \begin{displaymath}
      y \sim \textrm{exp} \left \{ \frac{y\Theta \, - \, f(\Theta)}{g(\phi)} \, + \, h(y,\phi) \right \}
    \end{displaymath}
  \item como:
    \begin{itemize}
    \item Gaussiana
    \item Binomial
    \item Poisson
    \item Gama
    \item Inversa da normal
    \end{itemize}
  \end{itemize}
\end{frame}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\begin{frame}[<+->]{A família exponencial de distribuições - Exemplo}
  \begin{itemize}
  \item A distribuição Poisson
    \begin{displaymath}
      f(y) = \frac{ e^{-\lambda} \lambda^{y}} {y!}
    \end{displaymath}
  \item Pertence à família exponencial porque pode ser expressa como
    \begin{displaymath}
      \textrm{exp} \left \{ \frac{y\Theta \, - \, f(\Theta)}{g(\phi)} \, + \, h(y,\phi) \right \}
    \end{displaymath}
  \item onde
    \begin{eqnarray*}
      \Theta&=& \ln(\lambda)\\
      f(\Theta)&=& e^{\lambda}\\
      g(\phi)&=&1 \\
      h(y, \Theta)&=&-\ln(y!)
    \end{eqnarray*}
  \end{itemize}
\end{frame}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\begin{frame}[<+->]{A função de ligação}
  \begin{itemize}
  \item Os glms têm esse nome porque generalizam a ideia de estabelecer uma relação do valor esperado com
    uma combinação linear de covariáveis:
    \begin{displaymath}
      \eta(E[Y]) \, = \, a_0 + a_1X_1 + \ldots + a_iX_i \, = \,\sum_0^i a_iX_i
    \end{displaymath}
  \item A função $\eta$ estabelece esta relação. Ela é chamada \textbf{função de ligação}.    
  \item Quando a função de ligação corresponde ao parâmetro $\Theta$ da família exponencial 
    ela é chamada \textbf{função de ligação canônica}. 
    Funções de ligação canônicas dão várias propriedades estatísticas importantes aos modelos.
  \end{itemize}
\end{frame}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\begin{frame}[<+->]{Exemplos de funções de ligação canônicas}
  \begin{itemize} 
  \item Função log para a Poisson:
    \begin{displaymath}
      \ln E[Y]\, = \, \ln \lambda \, = \, \sum_0^i a_iX_i
    \end{displaymath}
  \item Função logito para a binomial:
    \begin{displaymath}
      \ln \left( \frac{E[Y]}{n-E[Y]} \right) \, = \, \ln \left( \frac{p}{1-p} \right) \, = \,\sum_0^i a_iX_i
    \end{displaymath}
  \item Função identidade para a normal
    \begin{displaymath}
      E[Y] \, = \, \sum_0^i a_iX_i
    \end{displaymath}
  \end{itemize}
\end{frame}

