%=========================================================================
\begin{frame}{Modelo Binomial: Função Logística}
  \begin{itemize}
  \item Nosso modelo é:
    \begin{displaymath}
      Y \, \sim \, Bin(N=100, \, p=g(\textrm{distância}))
    \end{displaymath}\\
  \item <2->Que função usar para o efeito da distância sobre $p$?
  \item<3-> Uma função sigmóide limitada entre zero e um, como:
    \begin{displaymath}
      p = \frac{\textrm{e}^{a_0+a_1\textrm{dist}}}
      {1 + \textrm{e}^{a_0+a_1\textrm{dist}}}
    \end{displaymath}\\
  \item<4-> o que implica em
    \begin{displaymath}
      \ln\left(\frac{p}{1-p}\right)\, = \, a_0+a_1\textrm{dist}
    \end{displaymath}   
  \end{itemize}
\end{frame}


%=========================================================================
\begin{frame}{Modelo Binomial: Funções logística e \emph{logito}}
  \centerline{ \begin{tabular}{cc}
                 $p = \frac{\textrm{e}^{a+bX}}
                 {1 + \textrm{e}^{a+bX}}$ & $Y=\ln\left(\frac{p}{1-p}\right)$ \\
                 \includegraphics[width=0.4\textwidth]{figuras/logistica-1.pdf} & \includegraphics[width=0.4\textwidth]{figuras/logit-p-1.pdf} \\
               \end{tabular}}
           \end{frame}

%=========================================================================
\begin{frame}[containsverbatim]{Modelo Binomial: Ajuste no \R}
  
    \begin{block}{Função auxiliar: logística}    
      <<logistica-seed>>=
      logistica <- function(X, a0, a1){
          exp(a0 + a1*X) / (1 + exp(a0 + a1*X))
      }
      @ %def    
    \end{block}
    
\end{frame}

%=========================================================================
\begin{frame}[containsverbatim]{Modelo Binomial: Ajuste no \R}
  

  \begin{block}{Função de log-verossimilhança negativa}
    <<log-lik-seed>>=
    seed.LL1 <- function(a0, a1){
        eta  <- logistica(X=pred.seed$distancia, 
                                  a0=a0, a1=a1)
        -sum(dbinom(pred.seed$n.sobrev, size = 100, 
                    p = eta, log=T))
    }
    @ %def 
  \end{block}
  
\end{frame}

